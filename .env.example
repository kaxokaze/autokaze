# Public browser configuration: safe to expose, but do not put credentials here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only deployment configuration. Set these in the deployment platform,
# never commit their real values.
SUPABASE_SERVICE_ROLE_KEY=
TOKEN_ENCRYPTION_KEY=
OAUTH_STATE_SIGNING_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
META_OAUTH_APP_ID=
META_OAUTH_APP_SECRET=

# Comma-separated allowlist of fully qualified callback origins.
APP_ORIGIN=http://localhost:3000
